+import { supabase } from "@/integrations/supabase/client";
+import type { TablesInsert } from "@/integrations/supabase/types";
+
+export type ContractCreateResult = {
+  contractId: string;
+  onboardingCount: number;
+  onboardingError: Error | null;
+};
+
+export async function createContractWithOnboarding(payload: TablesInsert<"contracts">): Promise<ContractCreateResult> {
+  const { data, error } = await supabase.from("contracts").insert(payload).select("id").single();
+  if (error || !data) throw error ?? new Error("Não foi possível criar a contratação.");
+
+  const { data: generatedCount, error: onboardingError } = await supabase.rpc("generate_contract_onboarding", {
+    _contract_id: data.id,
+  });
+
+  return {
+    contractId: data.id,
+    onboardingCount: Number(generatedCount || 0),
+    onboardingError: onboardingError ? new Error(onboardingError.message) : null,
+  };
+}
